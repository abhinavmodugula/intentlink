{
  "manifest_version": 3,
  "name": "IntentLink",
  "version": "0.1.0",
  "description": "Carries a prompt from an agent chat into a real website and reshapes the page around it.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "webNavigation"],
  "host_permissions": [
    "https://api.deepseek.com/*",
    "https://api.typesafe.ai/*",
    "*://*.amazon.com/*",
    "*://*.uniqlo.com/*",
    "*://*.walmart.com/*",
    "*://*.opentable.com/*",
    "*://*.craigslist.org/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.amazon.com/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "lib/filters.js",
        "adapters/amazon-search.js",
        "adapters/amazon-product.js",
        "content.js"
      ],
      "css": ["reshape.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.uniqlo.com/*"],
      "js": ["lib/filters.js", "adapters/uniqlo-search.js", "content.js"],
      "css": ["reshape.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.walmart.com/*"],
      "js": [
        "lib/filters.js",
        "adapters/walmart-search.js",
        "adapters/walmart-product.js",
        "content.js"
      ],
      "css": ["reshape.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.opentable.com/*"],
      "js": ["lib/filters.js", "adapters/opentable-restaurant.js", "content.js"],
      "css": ["reshape.css", "adapters/opentable.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.craigslist.org/*"],
      "js": [
        "lib/filters.js",
        "adapters/craigslist-search.js",
        "adapters/craigslist-posting.js",
        "content.js"
      ],
      "css": ["reshape.css", "adapters/craigslist.css"],
      "run_at": "document_idle"
    }
  ]
}
